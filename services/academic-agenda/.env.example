# Copiar a .env y completar con credenciales reales. No versionar .env.
DB_ENABLED=true
FLASK_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:5003
DB_HOST=localhost
DB_PORT=3306
DB_NAME=riesgo_social_agenda
DB_USER=agenda_app
DB_PASSWORD=tu_contraseña_aquí
DB_SSL=true
# Opcional: ruta al CA de TiDB Cloud. Si se omite, se usa el almacén de CA del sistema.
DB_SSL_CA=
JWT_SECRET=tu_clave_secreta_aquí
PORT=5003
