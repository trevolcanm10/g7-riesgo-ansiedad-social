# Credenciales de la base de datos propia del Panel Institucional.
# Copiar a .env y completar con los valores del entorno. NO versionar .env.

# --- Base de datos propia (nunca la de otro microservicio) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_panel
DB_USER=
DB_PASS=

# --- Autenticacion ---
# Secreto compartido con el microservicio de usuarios para validar los JWT.
# Si falta, las rutas protegidas responden 500 en vez de aceptar peticiones.
JWT_SECRET=

# --- Servicio externo ---
# Base del microservicio de usuarios, consultado por HTTP para resolver
# la identidad de quien registra una atencion y el identificador del
# estudiante. Vacio desactiva la resolucion.
USERS_BASE_URL=http://localhost:3001

# Base del microservicio de evaluacion de riesgo, consultado por HTTP para
# correlacionar los perfiles de agrupamiento con el nivel de riesgo.
# Vacio desactiva la correlacion: el panel sigue funcionando sin ella.
RISK_EVALUATION_BASE_URL=http://localhost:3002

# --- HTTP ---
PORT=5003
FLASK_DEBUG=false
LOG_LEVEL=INFO
# Origenes permitidos para CORS, separados por coma.
CORS_ALLOW_ORIGIN=http://localhost:5174
