# Configuracion del Panel Institucional.
# Copiar a .env y completar. NO versionar .env.

# Base del gateway de Azure API Management. Debe ser HTTPS y terminar en
# .azure-api.net: el cliente rechaza cualquier otro host antes de llamar.
VITE_APIM_BASE_URL=https://apim-g7-riesgo-ansiedad.azure-api.net

# Clave de suscripcion de APIM. Queda expuesta en el bundle del navegador:
# solo para la demostracion institucional con una suscripcion limitada y
# revocable.
VITE_APIM_SUBSCRIPTION_KEY=

# Sufijo del microservicio de panel dentro de APIM.
VITE_APIM_PANEL_PATH=/panel/api/panel

# Sufijo del microservicio de usuarios, para el inicio de sesion.
# Ruta confirmada por el equipo: /u/users (misma convencion que la app movil).
VITE_APIM_USERS_PATH=/u/users
